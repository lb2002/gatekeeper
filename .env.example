# Copy to .env and fill in what you need. Never commit .env.
# The hosted demo, the install guard without a model, and `gk audit` need no keys at all.

# Meta Model API, for Muse Spark (`gk check --backend spark`): https://dev.meta.ai
MODEL_API_KEY=

# Partner inference for Muse Spark Open. One of these is enough.
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# Only for your own monitor deployment on Modal, used by `gk worker` and `gk review`
GK_API_URL=
GK_WORKER_TOKEN=
